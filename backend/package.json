{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Production-ready Chat Backend using Node.js, Express, TypeScript, MongoDB, and Firebase Firestore",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "npm run type-check"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "mongodb",
    "mongoose",
    "firebase",
    "firestore",
    "chat-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase-admin": "^13.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
